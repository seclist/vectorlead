# ==============================================================================
# VectorLead Configuration Template
# Copy this file to .env and configure your credentials
# ==============================================================================

# Google Sheets CRM Integration
# Path to Google Cloud Service Account JSON keyfile
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# Target Google Spreadsheet ID (from your Google Sheet URL: /d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Spreadsheet Title (used if discovering by name or creating new)
GOOGLE_SHEET_NAME=VectorLead CRM Tracker

# Local SQLite Database for caching prospects and preventing re-scraping
VECTORLEAD_CACHE_DB=vectorlead.db

# Default Discovery Settings
VECTORLEAD_DEFAULT_NICHE=personal_trainer
VECTORLEAD_MIN_AHS=60.0
VECTORLEAD_MAX_FOLLOWERS=100000
VECTORLEAD_MIN_NEW_LEADS=10

# Crawler Settings
CRAWLER_TIMEOUT_SECONDS=10
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_USER_AGENT=facebookexternalhit/1.1; Facebot; Twitterbot/1.0
